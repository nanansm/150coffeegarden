---
/**
 * Wedding & Events page body, rendered once per locale.
 *
 * The route files under src/pages/ are thin wrappers that only pick a locale,
 * so the two language versions can never drift structurally — only their copy
 * differs, and that lives in src/i18n/ui.ts.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppCTA from '../WhatsAppCTA.astro';
import AvailabilityCalendar from '../AvailabilityCalendar.astro';
import Gallery, { type GalleryPhoto } from '../Gallery.astro';
import VideoPlayer from '../VideoPlayer.astro';
import Faq from '../Faq.astro';
import StickyBar from '../StickyBar.astro';
import { nap, site, wa } from '../../data/site';
import { localizedPath, LOCALE_META, type Locale } from '../../i18n/config';
import { t, START_PRICE_IDR } from '../../i18n/ui';

import weddingStage from '../../assets/photos/wedding/elegance-arches.jpg';
import intimateStage from '../../assets/photos/wedding/intimate-stage.jpg';
import coupleJoy from '../../assets/photos/wedding/tent-reception.jpg';
import posterElegance from '../../assets/photos/wedding/poster-elegance.jpg';
import posterGarden from '../../assets/photos/wedding/poster-garden.jpg';
import decorChandelier from '../../assets/photos/wedding/decor-chandelier.jpg';
import decorGarden from '../../assets/photos/wedding/decor-garden.jpg';
import floralArch from '../../assets/photos/wedding/floral-arch.jpg';
import ceremonyDancers from '../../assets/photos/wedding/ceremony-dancers.jpg';
import receptionStage from '../../assets/photos/wedding/reception-stage.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const ROUTE = '/wedding/';

// Exactly six, so the 3-column grid lands as two clean rows with no orphan.
// Order keeps the two shots from the same (orange-floral) wedding off the same
// row so the set does not read as a near-duplicate pair.
const photos: GalleryPhoto[] = [
  { src: coupleJoy, ...ui.photos.coupleJoy },
  { src: ceremonyDancers, ...ui.photos.ceremonyDancers },
  { src: decorGarden, ...ui.photos.decorGarden },
  { src: floralArch, ...ui.photos.floralArch },
  { src: intimateStage, ...ui.photos.intimateStage },
  { src: receptionStage, ...ui.photos.receptionStage },
];

// Featured tier lands FIRST on mobile, where the cards stack.
const orderedPackages = [...ui.packages].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));

const pageUrl = new URL(localizedPath(ROUTE, locale), site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'EventVenue',
      '@id': `${pageUrl}#venue`,
      name: '150 Wedding Venue',
      description: ui.wedding.description,
      url: pageUrl,
      inLanguage: LOCALE_META[locale].htmlLang,
      telephone: `+${wa.wedding}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: nap.street,
        addressLocality: nap.district,
        addressRegion: nap.region,
        addressCountry: nap.country,
      },
      geo: { '@type': 'GeoCoordinates', latitude: nap.geo.lat, longitude: nap.geo.lng },
    },
    {
      '@type': 'Service',
      name: ui.wedding.packagesTitle,
      serviceType: 'Wedding venue',
      areaServed: 'Bandung',
      provider: { '@id': `${pageUrl}#venue` },
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: START_PRICE_IDR,
        priceCurrency: 'IDR',
        offerCount: ui.packages.length,
      },
    },
    {
      '@type': 'FAQPage',
      inLanguage: LOCALE_META[locale].htmlLang,
      mainEntity: ui.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: ui.nav.home,
          item: new URL(localizedPath('/', locale), site.url).href,
        },
        { '@type': 'ListItem', position: 2, name: ui.nav.wedding, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={ui.wedding.title}
  description={ui.wedding.description}
  route={ROUTE}
  {locale}
  ogImage="/og/wedding.jpg"
  pixelEvent="ViewContent"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  {/* 1 — Hero. Photo-led, asymmetric. Primary CTA is the calendar, not WA:
      checking a date is the qualifier and it is what sets this page apart. */}
  <section class="hero">
    <div class="hero__media">
      <Picture
        src={weddingStage}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[640, 1100, 1600]}
        sizes="(min-width: 64rem) 55vw, 100vw"
        quality={58}
        alt={ui.photos.weddingStage.alt}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="hero__panel">
      <div class="container hero__inner">
        <h1>{ui.wedding.h1}</h1>
        <p class="hero__lead">{ui.wedding.lead}</p>
        <p class="hero__price">{ui.wedding.priceBadge}</p>

        <ul class="hero__chips">
          {ui.wedding.heroChips.map((chip) => <li>{chip}</li>)}
        </ul>

        <div class="hero__cta">
          <a class="btn btn--block" href="#kalender">{ui.wedding.ctaCheckDate}</a>
          <WhatsAppCTA
            number={wa.wedding}
            message={ui.wa.weddingUmum}
            label={ui.wedding.ctaChat}
            variant="ghost"
            block
          />
        </div>
      </div>
    </div>
  </section>

  {/* 2 — Why here. The legacy markup for this block was unbalanced: the copy
      column never closed, so the two-column layout silently collapsed. */}
  <section class="section">
    <div class="container two">
      <div>
        <h2>{ui.wedding.whyTitle}</h2>
        <ul class="checks">
          {ui.wedding.whyList.map((line) => <li>{line}</li>)}
        </ul>
      </div>
      <figure class="two__media">
        <Picture
          src={decorChandelier}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[400, 640, 828]}
          sizes="(min-width: 48rem) 45vw, 100vw"
          quality={62}
          alt={ui.photos.decorChandelier.alt}
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  {/* 2b — Film. Real clips from the garden. Click-to-play, never autoplay:
      the video element does not exist until tapped, so it costs 0 bytes to
      everyone who scrolls past. */}
  <section class="section section--alt" id="film">
    <div class="container film">
      <div class="film__intro">
        <h2>{ui.wedding.filmTitle}</h2>
        <p class="lead">{ui.wedding.filmLead}</p>
      </div>
      <div class="films">
        <VideoPlayer
          name="wedding-elegance"
          poster={posterElegance}
          title={ui.photos.weddingStage.alt}
          label={ui.gallery.zoom(ui.wedding.filmTitle)}
          portrait
        />
        <VideoPlayer
          name="wedding-garden"
          poster={posterGarden}
          title={ui.photos.coupleJoy.alt}
          label={ui.gallery.zoom(ui.wedding.filmTitle)}
          portrait
        />
      </div>
    </div>
  </section>

  {/* 3 — Gallery */}
  <section class="section" id="galeri">
    <div class="container">
      <h2>{ui.wedding.galleryTitle}</h2>
      <p class="lead">{ui.wedding.galleryLead}</p>
      <div class="gal-wrap"><Gallery {photos} {locale} /></div>
    </div>
  </section>

  {/* 4 — Packages. Each tier carries its OWN prefilled WhatsApp message. The
      legacy page pointed all three at #action, losing which package the lead
      actually wanted. */}
  <section class="section section--alt" id="paket">
    <div class="container">
      <h2>{ui.wedding.packagesTitle}</h2>
      <p class="lead">{ui.wedding.packagesLead}</p>

      <div class="tiers">
        {
          orderedPackages.map((pkg) => (
            <article class:list={['tier', pkg.featured && 'tier--featured']}>
              <h3>{pkg.name}</h3>
              <p class="tier__price">{pkg.priceLabel}</p>
              <ul class="tier__list">
                {pkg.includes.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              <WhatsAppCTA
                number={wa.wedding}
                message={ui.wa.weddingPaket(pkg.name)}
                label={ui.wedding.packagesCta(pkg.name)}
                variant={pkg.featured ? 'on-green' : 'ghost'}
                block
              />
            </article>
          ))
        }
      </div>

      <p class="note">{ui.wedding.packagesNote}</p>
    </div>
  </section>

  {/* 5 — Availability calendar. The differentiator. */}
  <section class="section" id="kalender">
    <div class="container">
      <h2>{ui.wedding.calendarTitle}</h2>
      <p class="lead">{ui.wedding.calendarLead}</p>
      <div class="cal-wrap"><AvailabilityCalendar {locale} /></div>
    </div>
  </section>

  {/* 6 — Event & convention. Different audience, different admin. */}
  <section class="section section--alt" id="event">
    <div class="container two">
      <div>
        <h2>{ui.wedding.eventTitle}</h2>
        <p class="lead">{ui.wedding.eventLead}</p>
        <div class="event__cta">
          <WhatsAppCTA
            number={wa.reservasi}
            message={ui.wa.event}
            label={ui.wedding.eventCta}
            variant="ghost"
          />
        </div>
      </div>
      <ul class="uses">
        {ui.wedding.eventUses.map((use) => <li>{use}</li>)}
      </ul>
    </div>
  </section>

  {/* 7 — FAQ */}
  <section class="section" id="faq">
    <div class="container">
      <h2>{ui.wedding.faqTitle}</h2>
      <div class="faq-wrap"><Faq items={ui.faq} /></div>
    </div>
  </section>

  {/* 8 — Closing CTA */}
  <section class="section section--green">
    <div class="container closing">
      <h2>{ui.wedding.closingTitle}</h2>
      <p>{ui.wedding.closingLead}</p>
      <div class="closing__cta">
        <WhatsAppCTA
          number={wa.wedding}
          message={ui.wa.weddingUmum}
          label={ui.wedding.closingCta}
          variant="on-green"
        />
        <a class="btn btn--ghost btn--on-green-ghost" href="#kalender">
          {ui.wedding.closingSecondary}
        </a>
      </div>
    </div>
  </section>

  <StickyBar
    number={wa.wedding}
    message={ui.wa.weddingUmum}
    anchorHref="#kalender"
    anchorLabel={ui.wedding.stickyAnchor}
    waLabel={ui.common.whatsapp}
  />
</BaseLayout>

<style>
  /* --- Hero: asymmetric, not centred-text-over-full-bleed --- */
  .hero {
    display: grid;
  }

  /* Mobile: the image renders at its natural ratio (height:auto), so it stays
     as tall as the photo actually is and never balloons. A forced aspect-ratio
     + object-fit made the grid size the row to the source's full pixel height,
     which is what pushed the hero to ~1350px on a phone. */
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--neutral-100);
  }

  .hero__panel {
    background: var(--bg);
    padding-block: var(--sp-8) var(--sp-12);
  }

  .hero__lead {
    margin-block-start: var(--sp-4);
    font-size: var(--fs-lg);
    color: var(--text-muted);
    max-width: 46ch;
  }

  .hero__price {
    margin-block-start: var(--sp-6);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--green-600);
  }

  /* Factual chips: scannable proof under the price, no invented numbers —
     each maps to a verified fact (outdoor concept, dual-purpose, capacity). */
  .hero__chips {
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .hero__chips li {
    padding: 0.35em 0.9em;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--surface);
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-block-start: var(--sp-6);
  }

  @media (min-width: 30rem) {
    .hero__cta {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 55fr 45fr;
      align-items: center;
      gap: var(--sp-12);
      padding-inline-start: max(var(--gutter), calc((100vw - var(--container)) / 2));
    }

    .hero__panel {
      order: -1;
      /* Was --section-y: paired with the tall panel content it pushed the row
         past 1300px, and the image cover-cropped to a thin vertical slice. */
      padding-block: var(--sp-16);
    }

    .hero__inner {
      padding-inline: 0;
      max-width: 34rem;
      margin-inline: 0;
    }

    /* The media fills the row and bleeds off the right edge. Height follows the
       panel (capped), and object-fit cover crops without distorting — no fixed
       aspect-ratio fighting the grid row. */
    .hero__media {
      align-self: stretch;
      height: 100%;
    }

    .hero__media :global(picture) {
      display: block;
      height: 100%;
    }

    .hero__media :global(img) {
      height: 100%;
      max-height: 40rem;
      /* Desktop only: crop to fill the bleed column without distortion. */
      object-fit: cover;
      border-start-start-radius: var(--r-lg);
      border-end-start-radius: var(--r-lg);
    }
  }

  /* --- Shared --- */
  h2 {
    margin-block-start: var(--sp-2);
  }

  .lead {
    margin-block-start: var(--sp-4);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .section--green .lead,
  .closing p {
    color: var(--green-200);
  }

  .two {
    display: grid;
    gap: var(--sp-8);
  }

  @media (min-width: 48rem) {
    .two {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-12);
      align-items: center;
    }
  }

  .two__media :global(img) {
    width: 100%;
    /* Cap the portrait source so the row does not tower over the text column. */
    aspect-ratio: 4 / 5;
    max-height: 32rem;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }

  .checks {
    margin-block-start: var(--sp-6);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-3);
    max-width: var(--measure);
  }

  .checks li {
    position: relative;
    padding-inline-start: var(--sp-6);
    color: var(--text-muted);
  }

  /* The yellow hairline motif, reused as a list marker. No icon set. */
  .checks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 14px;
    height: 2px;
    background: var(--accent);
  }

  .event__cta {
    margin-block-start: var(--sp-6);
  }

  .gal-wrap,
  .cal-wrap,
  .faq-wrap {
    margin-block-start: var(--sp-8);
  }

  /* Film: heading on one side, the two clips on the other, so the section
     fills the width instead of stranding empty space beside a narrow block. */
  .film {
    display: grid;
    gap: var(--sp-8);
  }

  @media (min-width: 64rem) {
    .film {
      /* Copy takes the flexible column; the clips take exactly their capped
         width. A 1fr/1fr split let the 9:16 pair grow into two towers that
         dwarfed the text — this keeps them a tidy, deliberate size. */
      grid-template-columns: 1fr auto;
      gap: var(--sp-12);
      align-items: center;
    }

    .film__intro {
      max-width: 32rem;
    }
  }

  /* Two reels-style clips side by side. At 9:16 a pair stays compact even on a
     narrow phone. */
  .films {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
  }

  @media (min-width: 48rem) {
    .films {
      gap: var(--sp-5);
    }
  }

  @media (min-width: 64rem) {
    .films {
      /* Fixed pair width → each clip ~14rem, a refined reel rather than a wall. */
      width: 30rem;
    }
  }

  /* FAQ: on desktop the heading sits beside the questions, so the list spans
     the width of its column instead of stranding an empty right half. */
  @media (min-width: 64rem) {
    #faq :global(.container) {
      display: grid;
      grid-template-columns: 1fr 1.7fr;
      gap: var(--sp-16);
      align-items: start;
    }

    #faq :global(.container) > h2 {
      margin-block-start: 0;
    }

    #faq .faq-wrap {
      margin-block-start: 0;
    }
  }

  /* --- Tiers --- */
  .tiers {
    display: grid;
    gap: var(--sp-4);
    margin-block-start: var(--sp-8);
  }

  @media (min-width: 64rem) {
    .tiers {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-6);
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-6);
    /* Border, not shadow — see the shadow rule in tokens.css. */
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  /* Featured tier is promoted with a green fill, not a shadow or a scale. */
  .tier--featured {
    background: var(--green-600);
    color: var(--white);
    border-color: var(--green-600);
  }

  .tier__price {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--green-600);
  }

  .tier--featured .tier__price {
    color: var(--accent);
  }

  .tier__list {
    margin: 0;
    padding-inline-start: var(--sp-6);
    display: grid;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .tier--featured .tier__list {
    color: var(--green-200);
  }

  .tier :global(.btn) {
    margin-block-start: auto;
  }

  .note {
    margin-block-start: var(--sp-6);
    font-size: var(--fs-xs);
    color: var(--text-caption);
  }

  /* --- Uses list --- */
  .uses {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-2);
  }

  .uses li {
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
  }

  /* --- Closing --- */
  .closing {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--sp-4);
  }

  .closing__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
    margin-block-start: var(--sp-4);
  }

  .btn--on-green-ghost {
    color: var(--white);
    border-color: rgb(255 255 255 / 0.4);
  }
</style>
