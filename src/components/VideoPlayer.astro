---
/**
 * Click-to-play video, hosted on R2.
 *
 * Nothing is fetched until the visitor taps: the poster is a normal
 * Astro-optimised image (AVIF/WebP, responsive), and the <video> element is
 * only created on click. So the video costs 0 bytes to everyone who scrolls
 * past — which on a landing page is most people.
 *
 * No autoplay anywhere, by construction: the element does not exist until it
 * is asked for, and `preload` is left off until then.
 *
 * Why R2 and not the repo: these files are megabytes each and change without
 * a code deploy. Images stay in the repo because Astro's build turns them
 * into responsive AVIF, which R2 cannot do.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** File name in the R2 bucket under /video/, without extension. */
  name: string;
  poster: ImageMetadata;
  title: string;
  caption?: string;
  label: string;
  /** Full-bleed 16:9 treatment, for the hero film strip. */
  wide?: boolean;
  /** Vertical 9:16 treatment, for reels-style clips (e.g. wedding films). */
  portrait?: boolean;
}

const { name, poster, title, caption, label, wide = false, portrait = false } = Astro.props;

if (!/^[a-z0-9-]+$/.test(name)) {
  throw new Error(`VideoPlayer: unsafe video name ${JSON.stringify(name)}`);
}

const CDN = 'https://cdn.150coffeegarden.com';
const src = `${CDN}/video/${name}.mp4`;
---

<figure
  class:list={['vid', wide && 'vid--wide', portrait && 'vid--portrait']}
  data-video
  data-src={src}
  data-title={title}
>
  <button type="button" class="vid__btn" aria-label={`${label}: ${title}`}>
    <Picture
      src={poster}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={wide ? [640, 960, 1280, 1600] : portrait ? [360, 540, 720] : [400, 640, 854]}
      sizes={wide
        ? '100vw'
        : portrait
          ? '(min-width: 48rem) 45vw, 86vw'
          : '(min-width: 48rem) 33vw, 88vw'}
      quality={60}
      alt={title}
      loading="lazy"
    />
    <span class="vid__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
        <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z"
        ></path>
      </svg>
    </span>
  </button>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
  .vid {
    margin: 0;
  }

  .vid__btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--neutral-100);
    cursor: pointer;
  }

  /* Every card locks to 16:9 so a row of them lines up. The source clips
     differ (16:9 and 3:2), and left at natural ratio the boxes ended at
     different heights. A video thumbnail is the one place a small crop is
     the right trade for a tidy row. */
  .vid__btn :global(img) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .vid__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-content: center;
    width: 54px;
    height: 54px;
    padding-inline-start: 4px;
    border-radius: var(--r-full);
    background: rgb(255 255 255 / 0.92);
    color: var(--green-600);
    box-shadow: var(--shadow-md);
    transition: scale var(--dur) var(--ease);
  }

  .vid__btn:hover .vid__play {
    scale: 1.06;
  }

  /* Wide treatment: locked to 16:9 so the strip keeps a constant height
     across breakpoints. Corners stay rounded — it sits inside the grid now,
     not edge to edge. */
  .vid--wide .vid__btn :global(img),
  .vid--wide :global(video) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .vid--wide .vid__play {
    width: 68px;
    height: 68px;
  }

  /* Portrait treatment: reels-style 9:16. The clip keeps its full frame — a
     wedding video is composed vertical, so cover-cropping it would cut the
     ceremony out. Poster and video share the ratio to hold layout steady. */
  .vid--portrait .vid__btn :global(img),
  .vid--portrait :global(video) {
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }

  .vid--portrait :global(video) {
    object-fit: contain;
  }

  .vid :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    background: var(--green-900);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((wrap) => {
    const btn = wrap.querySelector('button');
    const src = wrap.dataset.src;
    if (!btn || !src) return;

    btn.addEventListener('click', () => {
      const video = document.createElement('video');
      video.src = src;
      video.controls = true;
      video.playsInline = true;
      video.preload = 'auto';
      // Not muted, not autoplay: this only runs from a real tap, so the
      // browser treats play() as user-initiated and sound is expected.
      video.setAttribute('title', wrap.dataset.title ?? '');
      btn.replaceWith(video);
      video.play().catch(() => {
        /* If the browser declines, the controls are right there. */
      });
    });
  });
</script>
