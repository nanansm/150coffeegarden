---
/**
 * The single source of truth for every WhatsApp link on the site.
 *
 * Renders a REAL static href at build time. This is deliberate: the legacy
 * wedding page had `href="#"` placeholders that JavaScript was supposed to
 * fill in and never did, so both primary CTAs were dead links in production.
 * Building the href at compile time means it works with JS disabled, it is
 * crawlable, and it cannot silently break that way again.
 *
 * The only runtime JS is a delegated listener that fires the Meta Pixel
 * `Contact` event on [data-wa] clicks — see src/scripts/pixel.ts.
 */
interface Props {
  number: string;
  message: string;
  label: string;
  variant?: 'solid' | 'ghost' | 'on-green';
  block?: boolean;
  class?: string;
  id?: string;
}

const {
  number,
  message,
  label,
  variant = 'solid',
  block = false,
  class: className = '',
  id,
} = Astro.props;

// Build-time assertion: a CTA missing its number or message must fail the
// build, not ship as a broken link.
if (!number || !/^\d{10,15}$/.test(number)) {
  throw new Error(
    `WhatsAppCTA: invalid number ${JSON.stringify(number)} for label "${label}". ` +
      `Expected 10-15 digits, international format without '+'.`,
  );
}
if (!message?.trim()) {
  throw new Error(`WhatsAppCTA: empty prefill message for label "${label}".`);
}

const href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;

const variantClass =
  variant === 'ghost' ? 'btn--ghost' : variant === 'on-green' ? 'btn--on-green' : '';
---

<a
  {id}
  {href}
  target="_blank"
  rel="noopener"
  data-wa
  class:list={['btn', variantClass, block && 'btn--block', className]}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.16c-.25.69-1.44 1.32-1.99 1.36-.53.04-1.02.23-3.44-.72-2.9-1.14-4.74-4.1-4.88-4.29-.14-.19-1.16-1.55-1.16-2.95s.73-2.09.99-2.38c.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.25.6.84 2.07.91 2.22.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.72 1.19 1.55 1.93 1.07.95 1.97 1.25 2.25 1.39.28.14.44.12.6-.07.17-.19.69-.8.87-1.08.19-.28.37-.23.63-.14.25.09 1.61.76 1.89.9.28.14.46.21.53.32.07.12.07.66-.18 1.35Z"
    ></path>
  </svg>
  {label}
</a>
