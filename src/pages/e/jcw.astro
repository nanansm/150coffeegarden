---
/**
 * Jakarta Coffee Week digital invitation.
 *
 * Standalone page — no site nav/header/footer, single job. English only,
 * not part of the id/en routing scheme. Default markup shows the invitation
 * form (screen 1); the event-details screen (screen 4) is present but
 * hidden. A <noscript><style> override flips that for JS-less visits, so
 * the page still makes sense without any script running.
 */
import '../../styles/fonts.css';
import '../../styles/tokens.css';
import '../../styles/base.css';
import { jcwEvent } from '../../data/jcw';

const MONTHS = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];

function formatDateRange(start: string, end: string): string {
  const [sy, sm, sd] = start.split('-').map(Number);
  const [ey, em, ed] = end.split('-').map(Number);
  if (sy === ey && sm === em) return `${MONTHS[sm - 1]} ${sd}–${ed}, ${sy}`;
  if (sy === ey) return `${MONTHS[sm - 1]} ${sd} – ${MONTHS[em - 1]} ${ed}, ${sy}`;
  return `${MONTHS[sm - 1]} ${sd}, ${sy} – ${MONTHS[em - 1]} ${ed}, ${ey}`;
}

const dateRange = formatDateRange(jcwEvent.startDate, jcwEvent.endDate);
const hours = `${jcwEvent.doorsOpen}–${jcwEvent.doorsClose} WIB`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>You are invited — 150 Coffee Garden</title>
    <noscript>
      <style>
        #screen-1 {
          display: none;
        }
        #screen-4 {
          display: block;
        }
      </style>
    </noscript>
  </head>
  <body>
    <div class="page">
      <div class="wrap">
        <section id="screen-1" class="screen">
          <p class="kicker">150 COFFEE GARDEN</p>
          <h1 class="title">You are invited.</h1>
          <p class="lead">We're bringing the garden to Jakarta Coffee Week.</p>
          <hr class="rule" />
          <form id="invite-form" novalidate>
            <div class="field">
              <label for="guest-name">Your name</label>
              <input id="guest-name" name="name" type="text" placeholder="Type it here" autocomplete="name" />
            </div>
            <p id="form-error" class="error" role="alert" hidden></p>
            <button type="submit" class="btn">Open my invitation</button>
          </form>
          <p class="hint">Turn your sound on.</p>
        </section>

        <section id="screen-2" class="screen" hidden>
          <p id="hello-line" class="hello"></p>

          <div id="player" class="player">
            <button type="button" id="play-btn" class="play" aria-label="Play the greeting">
              <svg id="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              <svg id="icon-pause" viewBox="0 0 24 24" aria-hidden="true" hidden>
                <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
              </svg>
              <svg id="icon-replay" viewBox="0 0 24 24" aria-hidden="true" hidden>
                <path
                  d="M12 5V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"
                />
              </svg>
            </button>
            <div id="progress" class="progress"><span id="progress-fill"></span></div>
          </div>

          <p id="voice-error" class="error" role="alert" hidden></p>
          <button type="button" id="next-btn" class="btn">Next</button>
        </section>

        <section id="screen-3" class="screen" hidden>
          <p class="lead">We'll drop it in your calendar.</p>
          <!-- The .ics href is the no-JS floor: every phone calendar opens
               one. With JS, `calendarTarget()` swaps in the Google link for
               non-Apple devices before the guest ever sees this screen. -->
          <a id="continue-btn" class="btn" href="/e/jcw.ics">Continue</a>
        </section>

        <section id="screen-4" class="screen" hidden>
          <h1 class="title">See you there.</h1>
          <dl class="details">
            <div>
              <dt>Event</dt>
              <dd>{jcwEvent.title}</dd>
            </div>
            <div>
              <dt>Date</dt>
              <dd>{dateRange}</dd>
            </div>
            <div>
              <dt>Doors</dt>
              <dd>{hours}</dd>
            </div>
            <div>
              <dt>Venue</dt>
              <dd>{jcwEvent.location}</dd>
            </div>
            {
              jcwEvent.venueDetail && (
                <div>
                  <dt>Find us</dt>
                  <dd>{jcwEvent.venueDetail}</dd>
                </div>
              )
            }
          </dl>
          <a id="calendar-link" class="btn" href="/e/jcw.ics">Continue</a>
          <p class="foot">Your name is used only for this greeting.</p>
        </section>

        <div class="logo">
          <img src="/brand/logo-green.webp" srcset="/brand/logo-green.webp 1x, /brand/logo-green@2x.webp 2x" alt="150 Coffee Garden" />
        </div>
      </div>
    </div>

    <script>
      import { googleCalendarUrl } from '../../data/jcw';

      const nameInput = document.getElementById('guest-name') as HTMLInputElement;
      const form = document.getElementById('invite-form') as HTMLFormElement;
      const errorEl = document.getElementById('form-error') as HTMLParagraphElement;
      const screen1 = document.getElementById('screen-1') as HTMLElement;
      const screen2 = document.getElementById('screen-2') as HTMLElement;
      const screen3 = document.getElementById('screen-3') as HTMLElement;
      const screen4 = document.getElementById('screen-4') as HTMLElement;
      const helloLine = document.getElementById('hello-line') as HTMLElement;
      const playBtn = document.getElementById('play-btn') as HTMLButtonElement;
      const iconPlay = document.getElementById('icon-play') as unknown as SVGElement;
      const iconPause = document.getElementById('icon-pause') as unknown as SVGElement;
      const iconReplay = document.getElementById('icon-replay') as unknown as SVGElement;
      const player = document.getElementById('player') as HTMLElement;
      const progress = document.getElementById('progress') as HTMLElement;
      const progressFill = document.getElementById('progress-fill') as HTMLElement;
      const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
      const voiceError = document.getElementById('voice-error') as HTMLParagraphElement;
      const continueBtn = document.getElementById('continue-btn') as HTMLAnchorElement;
      const calendarLink = document.getElementById('calendar-link') as HTMLAnchorElement;

      const NAME_PATTERN = /^[A-Za-z' .-]{2,30}$/;

      type PrefetchResult = { url: string } | { error: 'invalid_name' | 'rate_limited' | 'tts_failed' };

      let prefetchPromise: Promise<PrefetchResult> | null = null;
      let prefetchedName = '';
      let audioEl: HTMLAudioElement | null = null;

      /**
       * `loading` covers the gap between the tap and the greeting arriving.
       * The player element exists from the first gesture onward — it is the
       * only way an iPhone lets us start audio later — but it is holding a
       * silent unlock clip until `greetingReady` flips.
       */
      type PlayerState = 'loading' | 'idle' | 'playing' | 'ended';
      let playerState: PlayerState = 'loading';
      let greetingReady = false;

      /**
       * `hidden` is an HTMLElement property; an SVGElement takes the
       * assignment as a plain JS expando and the attribute never changes,
       * which silently inverts every icon. The attribute has to be set by
       * hand.
       */
      function showIcon(icon: SVGElement, visible: boolean) {
        if (visible) icon.removeAttribute('hidden');
        else icon.setAttribute('hidden', '');
      }

      function setPlayerState(next: PlayerState) {
        playerState = next;
        showIcon(iconPlay, next === 'idle' || next === 'loading');
        showIcon(iconPause, next === 'playing');
        showIcon(iconReplay, next === 'ended');
        playBtn.disabled = next === 'loading';
        progress.classList.toggle('is-loading', next === 'loading');
        helloLine.classList.toggle('is-playing', next === 'playing');
        playBtn.setAttribute(
          'aria-label',
          next === 'playing'
            ? 'Pause the greeting'
            : next === 'ended'
              ? 'Play the greeting again'
              : 'Play the greeting',
        );
      }

      function isValidName(value: string): boolean {
        if (!NAME_PATTERN.test(value)) return false;
        return value.split(/\s+/).length <= 2;
      }

      function showError(message: string) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      function clearError() {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      function prefetchVoice(name: string) {
        prefetchedName = name;
        prefetchPromise = fetch('/api/tts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name }),
        })
          .then(async (res) => {
            if (res.status === 429) return { error: 'rate_limited' } as const;
            if (res.status === 400) return { error: 'invalid_name' } as const;
            if (!res.ok) return { error: 'tts_failed' } as const;
            const data = await res.json();
            return { url: data.url as string };
          })
          .catch(() => ({ error: 'tts_failed' }) as const);
      }

      function handleNameCommit() {
        const value = nameInput.value.trim();
        if (!isValidName(value)) return;
        if (value === prefetchedName && prefetchPromise) return;
        prefetchVoice(value);
      }

      nameInput.addEventListener('blur', handleNameCommit);
      nameInput.addEventListener('change', handleNameCommit);

      function createSilentWavDataUri(): string {
        const sampleRate = 8000;
        const numSamples = Math.round(sampleRate * 0.1);
        const buffer = new ArrayBuffer(44 + numSamples);
        const view = new DataView(buffer);
        const writeString = (offset: number, str: string) => {
          for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
        };
        writeString(0, 'RIFF');
        view.setUint32(4, 36 + numSamples, true);
        writeString(8, 'WAVE');
        writeString(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true);
        view.setUint16(22, 1, true);
        view.setUint32(24, sampleRate, true);
        view.setUint32(28, sampleRate, true);
        view.setUint16(32, 1, true);
        view.setUint16(34, 8, true);
        writeString(36, 'data');
        view.setUint32(40, numSamples, true);
        const bytes = new Uint8Array(buffer);
        for (let i = 0; i < numSamples; i++) bytes[44 + i] = 128;
        let binary = '';
        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
        return 'data:audio/wav;base64,' + btoa(binary);
      }

      function goToScreen3() {
        screen1.hidden = true;
        screen2.hidden = true;
        helloLine.classList.remove('is-playing');
        screen3.hidden = false;
        screen4.hidden = true;
      }

      function goToScreen4() {
        screen1.hidden = true;
        screen2.hidden = true;
        helloLine.classList.remove('is-playing');
        screen3.hidden = true;
        screen4.hidden = false;
      }

      function calendarTarget(): string {
        return /iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) ? '/e/jcw.ics' : googleCalendarUrl();
      }

      // Both calendar controls resolve to the guest's own platform, so the
      // page never asks them to pick.
      continueBtn.href = calendarTarget();
      calendarLink.href = calendarTarget();

      // Continue navigates away on its own as a link. Advancing the screen
      // first means a guest who comes back from the calendar app lands on
      // the details rather than on the prompt they already answered.
      continueBtn.addEventListener('click', goToScreen4);

      nextBtn.addEventListener('click', goToScreen3);

      playBtn.addEventListener('click', () => {
        if (!audioEl || !greetingReady) return;
        if (playerState === 'playing') {
          audioEl.pause();
          return;
        }
        if (playerState === 'ended') audioEl.currentTime = 0;
        audioEl.play().catch(() => setPlayerState('idle'));
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const value = nameInput.value.trim();

        if (!value) {
          showError('We need a name to say hello.');
          return;
        }
        if (!isValidName(value)) {
          showError('Just your first name, please.');
          return;
        }
        clearError();

        // Unlock the player inside the gesture, before any await — no
        // Web Audio API, it does not respect the iPhone silent switch.
        const audio = new Audio(createSilentWavDataUri());
        audio.play().catch(() => {});
        audioEl = audio;
        greetingReady = false;

        // The unlock clip fires the same events as the greeting, so every
        // handler waits for `greetingReady` before touching the UI.
        audio.addEventListener('playing', () => {
          if (greetingReady) setPlayerState('playing');
        });
        audio.addEventListener('pause', () => {
          if (!greetingReady) return;
          // Browsers disagree on whether `pause` fires before or after
          // `ended` at the end of a clip, so the position decides rather
          // than the event order. Otherwise the icon settles on play when
          // it should offer a replay.
          const atEnd = audio.ended || (audio.duration > 0 && audio.currentTime >= audio.duration - 0.1);
          setPlayerState(atEnd ? 'ended' : 'idle');
        });
        audio.addEventListener('ended', () => {
          if (greetingReady) setPlayerState('ended');
        });
        audio.addEventListener('timeupdate', () => {
          if (!greetingReady || !audio.duration) return;
          progressFill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
        });

        voiceError.hidden = true;
        progressFill.style.width = '0';
        setPlayerState('loading');

        helloLine.textContent = `Hello, ${value}.`;
        screen1.hidden = true;
        screen2.hidden = false;

        if (value !== prefetchedName || !prefetchPromise) prefetchVoice(value);
        const pending = prefetchPromise as Promise<PrefetchResult>;

        pending.then((result) => {
          if ('error' in result) {
            // The guest keeps the screen and the Next button — losing the
            // sound is not a reason to yank them somewhere else.
            voiceError.textContent =
              result.error === 'rate_limited'
                ? "Too many requests right now. The sound will have to wait."
                : result.error === 'invalid_name'
                  ? 'Just your first name, please.'
                  : "Something went wrong with the sound.";
            voiceError.hidden = false;
            player.hidden = true;
            return;
          }

          if (!audioEl) return;
          greetingReady = true;
          audioEl.src = result.url;
          // Autoplay, still riding the unlock from the tap on screen 1. If a
          // browser refuses it, the button falls back to `idle` and the guest
          // starts it themselves — which is what the control is there for.
          audioEl.play().catch(() => setPlayerState('idle'));
        });
      });
    </script>

    <style>
      .page {
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--sp-8) var(--gutter);
      }

      .wrap {
        width: 100%;
        max-width: 34rem;
      }

      .screen {
        animation: fade-in var(--dur-slow) var(--ease) both;
      }

      .kicker {
        font-family: var(--font-body);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-eyebrow);
        text-transform: uppercase;
        color: var(--ink-400);
        margin-block-end: var(--sp-3);
      }

      .title {
        font-family: var(--font-display);
        font-size: var(--fs-h1);
        color: var(--ink-900);
        margin-block-end: var(--sp-4);
      }

      .lead {
        color: var(--ink-600);
      }

      .rule {
        border: none;
        border-top: 1px solid var(--yellow-400);
        margin-block: var(--sp-6);
      }

      .field {
        margin-block-end: var(--sp-4);
      }

      .field label {
        display: block;
        font-size: var(--fs-sm);
        color: var(--ink-900);
        margin-block-end: var(--sp-2);
      }

      .field input {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        padding: var(--sp-3) var(--sp-4);
        font-family: var(--font-body);
        font-size: var(--fs-base);
        color: var(--ink-900);
        background: var(--white);
      }

      .error {
        margin-block-end: var(--sp-4);
        font-size: var(--fs-sm);
        color: var(--ink-900);
      }

      .hint {
        margin-block-start: var(--sp-3);
        font-size: var(--fs-xs);
        color: var(--ink-400);
        text-align: center;
      }

      .hello {
        font-family: var(--font-display);
        font-size: var(--fs-display);
        color: var(--ink-900);
        text-align: center;
      }

      .hello.is-playing {
        animation: pulse 1.6s var(--ease) infinite;
      }

      /* Shown between the tap and the first audible word. The wait is short
         but never zero, and a name sitting alone on a blank screen reads as
         a page that broke. */
      /* `.player` sets display:flex, which outranks the browser's own
         [hidden] rule. Without this the error state would leave a dead
         play button on screen. */
      [hidden] {
        display: none !important;
      }

      /* A mark and a line, not a widget: the greeting is the moment, and a
         chunky media player would compete with the guest's own name. */
      .player {
        display: flex;
        align-items: center;
        gap: var(--sp-3);
        width: min(360px, 80%);
        margin: var(--sp-6) auto 0;
      }

      .play {
        flex: none;
        display: inline-flex;
        padding: var(--sp-2) 0;
        border: none;
        background: none;
        color: var(--green-600);
        cursor: pointer;
        transition: color var(--dur) var(--ease);
      }

      .play:hover {
        color: var(--green-500);
      }

      .play:disabled {
        opacity: 0.4;
        cursor: default;
      }

      .play svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
      }

      /* The same gold hairline as `.rule`, doing double duty: an
         indeterminate sweep until the greeting arrives, then the real
         playback position filling in green. One element, so the line never
         shifts when the state changes. */
      .progress {
        flex: 1 1 auto;
        height: 1px;
        background: var(--yellow-400);
        overflow: hidden;
      }

      .progress > span {
        display: block;
        width: 0;
        height: 100%;
        background: var(--green-600);
      }

      .progress.is-loading > span {
        width: 40%;
        animation: sweep 1.4s var(--ease) infinite;
      }

      .details {
        border: 1px solid var(--border);
        background: var(--bg-alt);
        border-radius: var(--r-lg);
        padding: var(--sp-6);
        margin-block: var(--sp-6);
      }

      .details > div + div {
        margin-block-start: var(--sp-4);
      }

      .details dt {
        font-size: var(--fs-xs);
        color: var(--ink-400);
        text-transform: uppercase;
        letter-spacing: var(--tracking-eyebrow);
      }

      .details dd {
        margin: 0;
        color: var(--ink-900);
        font-size: var(--fs-base);
      }

      /* Only the two calendar controls. The shared `.btn` carries no outer
         spacing, and screen 1's submit button already sits in a form that
         handles its own. */
      #continue-btn,
      #calendar-link,
      #next-btn {
        margin-block: var(--sp-6);
      }

      #next-btn {
        display: flex;
        width: fit-content;
        margin-inline: auto;
      }


      .link:hover {
        color: var(--green-500);
      }

      .foot {
        font-size: var(--fs-xs);
        color: var(--ink-400);
      }

      .logo {
        display: flex;
        justify-content: center;
        margin-block-start: var(--sp-16);
      }

      .logo img {
        height: 28px;
        width: auto;
        opacity: 0.7;
      }

      @keyframes fade-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      @keyframes sweep {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.7;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .screen {
          animation: none;
        }
        .hello.is-playing {
          animation: none;
        }
        .progress.is-loading > span {
          animation: none;
          width: 100%;
          opacity: 0.6;
        }
      }
    </style>
  </body>
</html>
