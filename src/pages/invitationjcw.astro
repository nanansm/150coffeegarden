---
/**
 * Jakarta Coffee Week digital invitation.
 *
 * Standalone page — no site nav/header/footer, single job. English only,
 * not part of the id/en routing scheme. Default markup shows the invitation
 * form (screen 1); the event-details screen (screen 4) is present but
 * hidden. A <noscript><style> override flips that for JS-less visits, so
 * the page still makes sense without any script running.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { jcwEvent } from '../data/jcw';
import { Image } from 'astro:assets';
import heroBooth from '../assets/jcw/hero-booth.png';
import maya from '../assets/jcw/maya.png';
import aetheria from '../assets/jcw/aetheria.png';
import aranya from '../assets/jcw/aranya.png';
import lockup from '../assets/jcw/lockup.png';

const bgWidths = [480, 828, 1200, 1672];
const thumbWidths = [240, 480];
const potions = [
  {
    img: maya,
    alt: 'A dark drink with a layer of crema in a glass, tropical fruit beside it',
    nama: 'MĀYĀ',
    day: 'Fri 4 Dec',
  },
  {
    img: aetheria,
    alt: 'A drink sealed under a clear bubble dome, mist falling around the glass',
    nama: 'AETHERIA’S SPARSHA',
    day: 'Sat 5 Dec',
  },
  {
    img: aranya,
    alt: 'A clear drink in a glass with lemon basil leaves and cucumber slices',
    nama: 'ARAṆYA',
    day: 'Sun 6 Dec',
  },
];

const MONTHS = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];

function formatDateRange(start: string, end: string): string {
  const [sy, sm, sd] = start.split('-').map(Number);
  const [ey, em, ed] = end.split('-').map(Number);
  if (sy === ey && sm === em) return `${MONTHS[sm - 1]} ${sd}–${ed}, ${sy}`;
  if (sy === ey) return `${MONTHS[sm - 1]} ${sd} – ${MONTHS[em - 1]} ${ed}, ${sy}`;
  return `${MONTHS[sm - 1]} ${sd}, ${sy} – ${MONTHS[em - 1]} ${ed}, ${ey}`;
}

const dateRange = formatDateRange(jcwEvent.startDate, jcwEvent.endDate);
const hours = `${jcwEvent.doorsOpen}–${jcwEvent.doorsClose} WIB`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#061D16" />
    <link rel="preload" href="/fonts/noto-serif-display-500-italic.woff2" as="font" type="font/woff2" crossorigin />
    <title>You are invited — 150 Coffee Garden</title>
    <noscript>
      <style>
        #screen-1 {
          display: none;
        }
        #screen-4 {
          display: block;
        }
      </style>
    </noscript>
  </head>
  <body>
    <div class="curtain curtain--l" aria-hidden="true"></div>
    <div class="curtain curtain--r" aria-hidden="true"></div>
    <div class="backdrop" aria-hidden="true">
      <Image
        src={heroBooth}
        alt=""
        format="webp"
        widths={bgWidths}
        sizes="100vw"
        loading="eager"
        aria-hidden="true"
        class="backdrop__img"
      />
    </div>
    <div class="page">
      <div class="logo">
        <img src="/brand/logo-green.webp" srcset="/brand/logo-green.webp 1x, /brand/logo-green@2x.webp 2x" alt="150 Coffee Garden" />
      </div>
      <div class="wrap">
        <section id="screen-1" class="screen">
          <Image src={lockup} alt="The Garden of Wonder" width={1000} loading="eager" class="lockup" />
          <p class="kicker">150 COFFEE GARDEN</p>
          <h1 class="title">You are invited.</h1>
          <p class="lead">We're bringing the garden to Jakarta Coffee Week.</p>
          <hr class="rule" />
          <form id="invite-form" novalidate>
            <div class="field">
              <label for="guest-name">Your name</label>
              <input id="guest-name" name="name" type="text" placeholder="Type it here" autocomplete="name" />
            </div>
            <p id="form-error" class="error" role="alert" hidden></p>
            <button type="submit" class="btn">Open my invitation</button>
          </form>
          <p class="hint">Turn your sound on.</p>
        </section>

        <section id="screen-2" class="screen" hidden>
          <p id="hello-line" class="hello"></p>

          <div id="player" class="player">
            <button type="button" id="play-btn" class="play" aria-label="Play the greeting">
              <svg id="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              <svg id="icon-pause" viewBox="0 0 24 24" aria-hidden="true" hidden>
                <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
              </svg>
              <svg id="icon-replay" viewBox="0 0 24 24" aria-hidden="true" hidden>
                <path
                  d="M12 5V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"
                />
              </svg>
            </button>
            <div id="progress" class="progress"><span id="progress-fill"></span></div>
          </div>

          <!-- Naming what is happening, rather than asking the guest to
               wait. The greeting is the whole point of the page, so the
               pause before it reads better as anticipation than as an
               apology. -->
          <p id="status-line" class="hint"></p>
          <p id="voice-error" class="error" role="alert" hidden></p>
          <!-- Hidden until the greeting is actually audible. Shown from the
               start, it invites a guest to tap past the one thing they came
               for. -->
          <button type="button" id="next-btn" class="btn" hidden>Next</button>
        </section>

        <section id="screen-3" class="screen" hidden>
          <p class="lead">We'll drop it in your calendar.</p>
          <!-- The .ics href is the no-JS floor: every phone calendar opens
               one. With JS, `calendarTarget()` swaps in the Google link for
               non-Apple devices before the guest ever sees this screen. -->
          <a id="continue-btn" class="btn" href="/e/jcw.ics">Continue</a>
        </section>

        <section id="screen-4" class="screen" hidden>
          <h1 class="title">See you there.</h1>
          <dl class="details">
            <div>
              <dt>Event</dt>
              <dd>{jcwEvent.title}</dd>
            </div>
            <div>
              <dt>Date</dt>
              <dd>{dateRange}</dd>
            </div>
            <div>
              <dt>Doors</dt>
              <dd>{hours}</dd>
            </div>
            <div>
              <dt>Venue</dt>
              <dd>{jcwEvent.location}</dd>
            </div>
            {
              jcwEvent.venueDetail && (
                <div>
                  <dt>Find us</dt>
                  <dd>{jcwEvent.venueDetail}</dd>
                </div>
              )
            }
          </dl>
          <a id="calendar-link" class="btn" href="/e/jcw.ics">Continue</a>
          <ul class="potions">
            {
              potions.map((p) => (
                <li>
                  <Image
                    src={p.img}
                    alt={p.alt}
                    format="webp"
                    widths={thumbWidths}
                    sizes="(min-width: 28rem) 9rem, 30vw"
                    loading="lazy"
                    class="potions__img"
                  />
                  <span class="potions__name">{p.nama}</span>
                  <span class="potions__day">{p.day}</span>
                </li>
              ))
            }
          </ul>
          <p class="foot">Your name is used only for this greeting.</p>
        </section>
      </div>
    </div>

    <script>
      import { googleCalendarUrl } from '../data/jcw';

      const nameInput = document.getElementById('guest-name') as HTMLInputElement;
      const form = document.getElementById('invite-form') as HTMLFormElement;
      const errorEl = document.getElementById('form-error') as HTMLParagraphElement;
      const screen1 = document.getElementById('screen-1') as HTMLElement;
      const screen2 = document.getElementById('screen-2') as HTMLElement;
      const screen3 = document.getElementById('screen-3') as HTMLElement;
      const screen4 = document.getElementById('screen-4') as HTMLElement;
      const helloLine = document.getElementById('hello-line') as HTMLElement;
      const playBtn = document.getElementById('play-btn') as HTMLButtonElement;
      const iconPlay = document.getElementById('icon-play') as unknown as SVGElement;
      const iconPause = document.getElementById('icon-pause') as unknown as SVGElement;
      const iconReplay = document.getElementById('icon-replay') as unknown as SVGElement;
      const player = document.getElementById('player') as HTMLElement;
      const progress = document.getElementById('progress') as HTMLElement;
      const progressFill = document.getElementById('progress-fill') as HTMLElement;
      const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
      const statusLine = document.getElementById('status-line') as HTMLParagraphElement;
      const voiceError = document.getElementById('voice-error') as HTMLParagraphElement;
      const continueBtn = document.getElementById('continue-btn') as HTMLAnchorElement;
      const calendarLink = document.getElementById('calendar-link') as HTMLAnchorElement;

      const NAME_PATTERN = /^[A-Za-z' .-]{2,30}$/;

      type PrefetchResult = { url: string } | { error: 'invalid_name' | 'rate_limited' | 'tts_failed' };

      let prefetchPromise: Promise<PrefetchResult> | null = null;
      let prefetchedName = '';
      let audioEl: HTMLAudioElement | null = null;

      /**
       * `loading` covers the gap between the tap and the greeting arriving.
       * The player element exists from the first gesture onward — it is the
       * only way an iPhone lets us start audio later — but it is holding a
       * silent unlock clip until `greetingReady` flips.
       */
      type PlayerState = 'loading' | 'idle' | 'playing' | 'ended';
      let playerState: PlayerState = 'loading';
      let greetingReady = false;

      /**
       * The escape hatch. `Next` normally waits for the first audible word,
       * but a guest must never be stuck behind a greeting that is not
       * coming — so a failed call, or a wait this long, releases it anyway.
       */
      const NEXT_FALLBACK_MS = 15000;
      let nextTimer: ReturnType<typeof setTimeout> | undefined;

      function revealNext() {
        clearTimeout(nextTimer);
        nextTimer = undefined;
        nextBtn.hidden = false;
      }

      /**
       * `hidden` is an HTMLElement property; an SVGElement takes the
       * assignment as a plain JS expando and the attribute never changes,
       * which silently inverts every icon. The attribute has to be set by
       * hand.
       */
      function showIcon(icon: SVGElement, visible: boolean) {
        if (visible) icon.removeAttribute('hidden');
        else icon.setAttribute('hidden', '');
      }

      function setPlayerState(next: PlayerState) {
        playerState = next;
        showIcon(iconPlay, next === 'idle' || next === 'loading');
        showIcon(iconPause, next === 'playing');
        showIcon(iconReplay, next === 'ended');
        playBtn.disabled = next === 'loading';
        progress.classList.toggle('is-loading', next === 'loading');
        helloLine.classList.toggle('is-playing', next === 'playing');
        helloLine.classList.toggle('is-waiting', next === 'loading');
        // `idle` after the greeting has arrived means a browser refused the
        // autoplay, so the line turns into the instruction it needs to be.
        statusLine.textContent =
          next === 'loading'
            ? 'Getting your greeting ready\u2026'
            : next === 'idle' && greetingReady
              ? 'Tap play to hear it.'
              : '';
        statusLine.hidden = statusLine.textContent === '';
        playBtn.setAttribute(
          'aria-label',
          next === 'playing'
            ? 'Pause the greeting'
            : next === 'ended'
              ? 'Play the greeting again'
              : 'Play the greeting',
        );
      }

      function isValidName(value: string): boolean {
        if (!NAME_PATTERN.test(value)) return false;
        return value.split(/\s+/).length <= 2;
      }

      function showError(message: string) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      function clearError() {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      function prefetchVoice(name: string) {
        prefetchedName = name;
        prefetchPromise = fetch('/api/tts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name }),
        })
          .then(async (res) => {
            if (res.status === 429) return { error: 'rate_limited' } as const;
            if (res.status === 400) return { error: 'invalid_name' } as const;
            if (!res.ok) return { error: 'tts_failed' } as const;
            const data = await res.json();
            return { url: data.url as string };
          })
          .catch(() => ({ error: 'tts_failed' }) as const);
      }

      function handleNameCommit() {
        const value = nameInput.value.trim();
        if (!isValidName(value)) return;
        if (value === prefetchedName && prefetchPromise) return;
        prefetchVoice(value);
      }

      nameInput.addEventListener('blur', handleNameCommit);
      nameInput.addEventListener('change', handleNameCommit);

      function createSilentWavDataUri(): string {
        const sampleRate = 8000;
        const numSamples = Math.round(sampleRate * 0.1);
        const buffer = new ArrayBuffer(44 + numSamples);
        const view = new DataView(buffer);
        const writeString = (offset: number, str: string) => {
          for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
        };
        writeString(0, 'RIFF');
        view.setUint32(4, 36 + numSamples, true);
        writeString(8, 'WAVE');
        writeString(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true);
        view.setUint16(22, 1, true);
        view.setUint32(24, sampleRate, true);
        view.setUint32(28, sampleRate, true);
        view.setUint16(32, 1, true);
        view.setUint16(34, 8, true);
        writeString(36, 'data');
        view.setUint32(40, numSamples, true);
        const bytes = new Uint8Array(buffer);
        for (let i = 0; i < numSamples; i++) bytes[44 + i] = 128;
        let binary = '';
        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
        return 'data:audio/wav;base64,' + btoa(binary);
      }

      function goToScreen3() {
        screen1.hidden = true;
        screen2.hidden = true;
        helloLine.classList.remove('is-playing');
        screen3.hidden = false;
        screen4.hidden = true;
      }

      function goToScreen4() {
        screen1.hidden = true;
        screen2.hidden = true;
        helloLine.classList.remove('is-playing');
        screen3.hidden = true;
        screen4.hidden = false;
      }

      function calendarTarget(): string {
        return /iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) ? '/e/jcw.ics' : googleCalendarUrl();
      }

      // Both calendar controls resolve to the guest's own platform, so the
      // page never asks them to pick.
      continueBtn.href = calendarTarget();
      calendarLink.href = calendarTarget();

      // Continue navigates away on its own as a link. Advancing the screen
      // first means a guest who comes back from the calendar app lands on
      // the details rather than on the prompt they already answered.
      continueBtn.addEventListener('click', goToScreen4);

      nextBtn.addEventListener('click', goToScreen3);

      playBtn.addEventListener('click', () => {
        if (!audioEl || !greetingReady) return;
        if (playerState === 'playing') {
          audioEl.pause();
          return;
        }
        if (playerState === 'ended') audioEl.currentTime = 0;
        audioEl.play().catch(() => setPlayerState('idle'));
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const value = nameInput.value.trim();

        if (!value) {
          showError('We need a name to say hello.');
          return;
        }
        if (!isValidName(value)) {
          showError('Just your first name, please.');
          return;
        }
        clearError();

        // Unlock the player inside the gesture, before any await — no
        // Web Audio API, it does not respect the iPhone silent switch.
        const audio = new Audio(createSilentWavDataUri());
        audio.play().catch(() => {});
        audioEl = audio;
        greetingReady = false;

        // The unlock clip fires the same events as the greeting, so every
        // handler waits for `greetingReady` before touching the UI.
        audio.addEventListener('playing', () => {
          if (!greetingReady) return;
          setPlayerState('playing');
          revealNext();
        });
        audio.addEventListener('pause', () => {
          if (!greetingReady) return;
          // Browsers disagree on whether `pause` fires before or after
          // `ended` at the end of a clip, so the position decides rather
          // than the event order. Otherwise the icon settles on play when
          // it should offer a replay.
          const atEnd = audio.ended || (audio.duration > 0 && audio.currentTime >= audio.duration - 0.1);
          setPlayerState(atEnd ? 'ended' : 'idle');
        });
        audio.addEventListener('ended', () => {
          if (greetingReady) setPlayerState('ended');
        });
        audio.addEventListener('timeupdate', () => {
          if (!greetingReady || !audio.duration) return;
          progressFill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
        });

        voiceError.hidden = true;
        progressFill.style.width = '0';
        nextBtn.hidden = true;
        clearTimeout(nextTimer);
        nextTimer = setTimeout(revealNext, NEXT_FALLBACK_MS);
        setPlayerState('loading');

        helloLine.textContent = `Hello, ${value}.`;
        screen1.hidden = true;
        screen2.hidden = false;

        if (value !== prefetchedName || !prefetchPromise) prefetchVoice(value);
        const pending = prefetchPromise as Promise<PrefetchResult>;

        pending.then((result) => {
          if ('error' in result) {
            // One line for every cause. A guest cannot act on the
            // difference between an exhausted quota and a failed call, and
            // naming a fault they did not cause only worries them. The
            // reason stays in the response code for the logs.
            voiceError.textContent = 'No sound available right now.';
            voiceError.hidden = false;
            player.hidden = true;
            statusLine.hidden = true;
            // The state machine never leaves `loading` on this path, so the
            // waiting pulse has to be lifted by hand or the name keeps
            // breathing under a message that says nothing is coming.
            helloLine.classList.remove('is-waiting');
            revealNext();
            return;
          }

          if (!audioEl) return;
          greetingReady = true;
          audioEl.src = result.url;
          // Autoplay, still riding the unlock from the tap on screen 1. If a
          // browser refuses it, the button falls back to `idle` and the guest
          // starts it themselves — which is what the control is there for.
          audioEl.play().catch(() => setPlayerState('idle'));
        });
      });
    </script>

    <style>
      @font-face {
        font-family: 'Noto Serif Display';
        font-weight: 500;
        font-style: normal;
        font-display: swap;
        src: url('/fonts/noto-serif-display-500.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Noto Serif Display';
        font-weight: 500;
        font-style: italic;
        font-display: swap;
        src: url('/fonts/noto-serif-display-500-italic.woff2') format('woff2');
      }

      :global(html),
      :global(body) {
        margin: 0;
        background: #061d16;
        overflow-x: clip;
      }

      .page {
        --gow-forest: #061d16;
        --gow-garden: #0d4f33;
        --gow-leaf: #2f7a4c;
        --gow-gold: #c3a66b;
        --gow-copper: #c98b42;
        --gow-cream: #f3ebdd;
        --gow-display: 'Noto Serif Display', 'Times New Roman', serif;

        box-sizing: border-box;
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.25rem;
        position: relative;
        z-index: 1;
        color: var(--gow-cream);
        font-family: var(--font-body, 'DM Sans', system-ui, sans-serif);
        font-size: 1.0625rem;
        line-height: 1.65;
        overflow-x: clip;
      }

      .page *,
      .page *::before,
      .page *::after {
        box-sizing: border-box;
      }

      .page :focus-visible {
        outline: 2px solid var(--gow-gold);
        outline-offset: 3px;
      }

      .wrap {
        width: 100%;
        max-width: 28rem;
        min-width: 0;
      }

      .screen {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0;
        padding-block: 2rem;
        margin: 0;
      }

      .screen p {
        margin: 0;
      }

      .kicker {
        font-family: var(--font-body, 'DM Sans', system-ui, sans-serif);
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--gow-gold);
        margin-block-end: 1.5rem;
      }

      .title {
        font-family: var(--gow-display);
        font-style: normal; /* the "500" file holds the slanted cut, same as /jcw headings */
        font-weight: 500;
        font-size: clamp(2.5rem, 11vw, 3.75rem);
        line-height: 1.05;
        letter-spacing: -0.01em;
        text-wrap: balance;
        color: var(--gow-cream);
        margin: 0 0 1.5rem;
      }

      .lead {
        color: var(--gow-cream);
        opacity: 0.88;
        text-wrap: pretty;
      }

      .rule {
        border: none;
        border-top: 1px solid var(--gow-gold);
        opacity: 0.6;
        margin-block: 2rem;
        width: 100%;
      }

      .field {
        margin-block-end: 1.25rem;
      }

      .field label {
        display: block;
        font-size: 0.8125rem;
        color: var(--gow-gold);
        margin-block-end: 0.25rem;
      }

      .field input {
        width: 100%;
        min-height: 3rem;
        border: none;
        border-bottom: 1px solid var(--gow-gold);
        border-radius: 0;
        padding: 0.5rem 0;
        font-family: var(--font-body, 'DM Sans', system-ui, sans-serif);
        font-size: 1.25rem;
        color: var(--gow-cream);
        background: transparent;
        appearance: none;
        -webkit-appearance: none;
      }

      .field input::placeholder {
        color: var(--gow-cream);
        opacity: 0.6;
      }

      .field input:focus,
      .field input:focus-visible {
        outline: none;
        border-bottom-width: 2px;
        padding-bottom: calc(0.5rem - 1px);
        box-shadow: 0 1px 0 0 var(--gow-gold);
      }

      .error {
        margin-block-end: 1.25rem;
        font-size: 0.9375rem;
        color: #f2b8a8;
      }

      .hint {
        margin-block-start: 1rem;
        font-size: 0.875rem;
        color: var(--gow-cream);
        opacity: 0.75;
        text-align: center;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        padding: 0.75rem 1.75rem;
        border: none;
        border-radius: 4px;
        background: var(--gow-copper);
        color: var(--gow-forest);
        font-family: var(--font-body, 'DM Sans', system-ui, sans-serif);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.2;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .btn:hover {
        background: #d89a50;
      }

      .btn:disabled {
        opacity: 0.5;
        cursor: default;
      }

      #invite-form .btn {
        width: 100%;
      }

      .hello {
        font-family: var(--gow-display);
        font-style: normal; /* the "500" file holds the slanted cut, same as /jcw headings */
        font-weight: 500;
        font-size: clamp(2.25rem, 10vw, 3.5rem);
        line-height: 1.1;
        text-wrap: balance;
        overflow-wrap: anywhere;
        color: var(--gow-cream);
        text-align: center;
      }

      @media (prefers-reduced-motion: no-preference) {
        .hello.is-playing {
          animation: pulse 1.6s ease-in-out infinite;
        }

        /* Dimmer and slower than the playing pulse, so the two states never
           read as the same thing. */
        .hello.is-waiting {
          animation: pulse-wait 1.8s ease-in-out infinite;
        }
      }

      /* Shown between the tap and the first audible word. The wait is short
         but never zero, and a name sitting alone on a blank screen reads as
         a page that broke. */
      /* `.player` sets display:flex, which outranks the browser's own
         [hidden] rule. Without this the error state would leave a dead
         play button on screen. */
      [hidden] {
        display: none !important;
      }

      /* A mark and a line, not a widget: the greeting is the moment, and a
         chunky media player would compete with the guest's own name. */
      .player {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
        max-width: 22rem;
        margin: 2.5rem auto 0;
      }

      .play {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        padding: 0;
        border: 1px solid var(--gow-gold);
        border-radius: 50%;
        background: transparent;
        color: var(--gow-cream);
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .play:hover {
        background: rgba(195, 166, 107, 0.16);
      }

      .play:disabled {
        opacity: 0.4;
        cursor: default;
      }

      .play svg {
        width: 20px;
        height: 20px;
        fill: currentColor;
      }

      /* The same gold hairline as `.rule`, doing double duty: an
         indeterminate sweep until the greeting arrives, then the real
         playback position filling in green. One element, so the line never
         shifts when the state changes. */
      .progress {
        flex: 1 1 auto;
        height: 1px;
        background: rgba(195, 166, 107, 0.45);
        overflow: hidden;
      }

      .progress > span {
        display: block;
        width: 0;
        height: 100%;
        background: var(--gow-cream);
      }

      .progress.is-loading > span {
        width: 40%;
      }

      @media (prefers-reduced-motion: no-preference) {
        .progress.is-loading > span {
          animation: sweep 1.4s ease-in-out infinite;
        }
      }

      .details {
        margin: 2rem 0 0;
        padding: 0;
        border-top: 1px solid var(--gow-gold);
      }

      .details > div {
        padding-block: 1rem;
        border-bottom: 1px solid rgba(195, 166, 107, 0.35);
      }

      .details dt {
        font-size: 0.75rem;
        color: var(--gow-gold);
        text-transform: uppercase;
        letter-spacing: 0.18em;
      }

      .details dd {
        margin: 0.25rem 0 0;
        color: var(--gow-cream);
        font-size: 1.0625rem;
        overflow-wrap: anywhere;
      }

      /* Only the two calendar controls. The shared `.btn` carries no outer
         spacing, and screen 1's submit button already sits in a form that
         handles its own. */
      #continue-btn,
      #calendar-link,
      #next-btn {
        margin-block: 2rem;
        align-self: flex-start;
      }

      #next-btn {
        align-self: auto;
        display: flex;
        width: fit-content;
        margin-inline: auto;
      }

      /* Screen 1's error sits under the input it belongs to and stays left.
         This one stands alone under the name, so it centres with it. */
      #voice-error {
        text-align: center;
      }


      .link {
        color: var(--gow-gold);
      }

      .link:hover {
        color: var(--gow-cream);
      }

      .foot {
        font-size: 0.875rem;
        color: var(--gow-cream);
        opacity: 0.75;
      }

      .logo {
        position: absolute;
        top: 1rem;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
      }

      .backdrop {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background: #061d16;
      }

      .backdrop :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .backdrop::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(to bottom, rgba(6, 29, 22, 0.55) 0%, rgba(6, 29, 22, 0.78) 45%, rgba(6, 29, 22, 0.94) 100%),
          radial-gradient(ellipse 70% 50% at 50% 38%, rgba(6, 29, 22, 0.5), transparent 75%);
      }

      .screen :global(.lockup) {
        display: block;
        width: 100%;
        max-width: 15rem;
        height: auto;
        margin: 0 0 1.5rem;
        filter: brightness(1.25) drop-shadow(0 0 22px rgba(6, 29, 22, 0.95));
      }

      .potions {
        list-style: none;
        margin: 0 0 2rem;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
      }

      .potions li {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      .potions :global(.potions__img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        border-radius: 2px;
      }

      .potions__name {
        margin-block-start: 0.5rem;
        font-family: var(--gow-display);
        font-style: normal;
        font-weight: 500;
        font-size: 0.75rem;
        line-height: 1.25;
        color: var(--gow-cream);
        overflow-wrap: anywhere;
      }

      .potions__day {
        margin-block-start: 0.25rem;
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gow-gold);
      }

      .curtain {
        position: fixed;
        top: 0;
        bottom: 0;
        width: 50%;
        z-index: 100;
        pointer-events: none;
        background:
          linear-gradient(to bottom, transparent 82%, rgba(6, 29, 22, 0.55) 100%),
          repeating-linear-gradient(90deg, #0d4f33 0, #0d4f33 34px, #0b4530 52px, #0d4f33 70px);
        animation-duration: 1.4s;
        animation-delay: 0.45s;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        animation-fill-mode: forwards;
      }

      .curtain--l {
        left: 0;
        box-shadow: 1px 0 0 0 #c3a66b, 0 0 18px 2px rgba(195, 166, 107, 0.45);
        animation-name: curtain-open-l;
      }

      .curtain--r {
        right: 0;
        box-shadow: -1px 0 0 0 #c3a66b, 0 0 18px 2px rgba(195, 166, 107, 0.45);
        animation-name: curtain-open-r;
      }

      @keyframes curtain-open-l {
        0% {
          transform: translateX(0);
          visibility: visible;
        }
        99.9% {
          visibility: visible;
        }
        100% {
          transform: translateX(-100%);
          visibility: hidden;
        }
      }

      @keyframes curtain-open-r {
        0% {
          transform: translateX(0);
          visibility: visible;
        }
        99.9% {
          visibility: visible;
        }
        100% {
          transform: translateX(100%);
          visibility: hidden;
        }
      }

      .logo img {
        height: 28px;
        width: auto;
        max-width: 100%;
        opacity: 0.85;
        filter: brightness(0) invert(0.93) sepia(0.15);
      }

      @media (prefers-reduced-motion: no-preference) {
        .screen {
          animation: fade-in 0.5s ease both;
        }
      }

      @keyframes fade-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      @keyframes sweep {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }

      @keyframes pulse-wait {
        0%,
        100% {
          opacity: 0.55;
        }
        50% {
          opacity: 0.9;
        }
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.7;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .curtain {
          display: none;
        }
        .screen {
          animation: none;
        }
        .hello.is-playing {
          animation: none;
        }
        .hello.is-waiting {
          animation: none;
          opacity: 0.7;
        }
        .progress.is-loading > span {
          animation: none;
          width: 100%;
          opacity: 0.6;
        }
      }
    </style>
  </body>
</html>
